# my.cnf — MariaDB server configuration

[mysqld]
# Listen on all interfaces inside the container (not just localhost)
# so WordPress can connect from another container
bind-address            = 0.0.0.0

# The data directory where MariaDB stores all database files
# Must match the volume mount point
datadir                 = /var/lib/mysql

# Use the unix socket AND tcp. The socket is used for local root login,
# tcp is used by WordPress connecting over the docker network
socket                  = /run/mysqld/mysqld.sock
port                    = 3306

# Character set — utf8mb4 is full unicode (supports emojis etc.)
character-set-server    = utf8mb4
collation-server        = utf8mb4_general_ci

[client]
socket                  = /run/mysqld/mysqld.sock